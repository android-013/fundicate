DATABASE_URL="postgresql://fundicate:CHANGE_ME@127.0.0.1:54329/fundicate"
APP_ORIGIN="http://127.0.0.1:3000"
# For external PostgreSQL, copy this file to .env and set DATABASE_URL.
# npm run db:local creates .env with a random password for a project-local cluster.
# Demo seed is opt-in and refuses to run with NODE_ENV=production.
ALLOW_DEMO_SEED="false"
FUNDICATE_MODE="standalone"
# If behind a trusted reverse proxy which overwrites the header and blocks direct access:
# TRUSTED_CLIENT_IP_HEADER="x-real-ip"
# Never expose application/database credentials as NEXT_PUBLIC_ variables.
