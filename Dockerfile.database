# syntax=docker/dockerfile:1
# Keep PostgreSQL 18 and Debian Bookworm/glibc compatible with existing clusters.
ARG POSTGRES_BASE=postgres:18-bookworm@sha256:f1ea2a1a4fb7b68d4836be1fdcb8a6466a89b072158bf9d97663600538c294c5

# Rebuild the exact gosu 1.20 release with a supported, patched Go toolchain.
# Only the statically linked executable is copied into the database image.
FROM --platform=$BUILDPLATFORM golang:1.27.4-alpine@sha256:0a5f7fe796599ff487605987432e7619ae45beeb2fba4c2ce0b907879932aebf AS gosu
ENV GOTOOLCHAIN=local
WORKDIR /src
RUN set -eux; \
    wget -T 60 -O /tmp/gosu.tar.gz https://codeload.github.com/tianon/gosu/tar.gz/29b939aa5bd4dc588af765b8248f6e39150d2565; \
    echo '2b70da8a5480fafedc16bb1fc91b572f064d03df736cbd91a616af2f1b66ab51  /tmp/gosu.tar.gz' | sha256sum -c -; \
    tar -xzf /tmp/gosu.tar.gz --strip-components=1; \
    go mod download; \
    go mod verify

ARG TARGETOS
ARG TARGETARCH
ARG TARGETVARIANT
RUN --network=none set -eux; \
    case "$TARGETARCH/$TARGETVARIANT" in \
        arm/v5) export GOARM=5 ;; \
        arm/v6|arm/v7) export GOARM=6 ;; \
        arm/*) exit 1 ;; \
    esac; \
    GOOS="$TARGETOS" GOARCH="$TARGETARCH" CGO_ENABLED=0 \
      go build -mod=readonly -trimpath -ldflags '-d -w' -o /gosu .; \
    go version -m /gosu

FROM ${POSTGRES_BASE}
USER root
COPY --from=gosu /gosu /usr/local/bin/gosu
ENV GOSU_VERSION=1.20

# Refresh signed Bookworm and PGDG repositories. Remove SQLite and the GnuPG
# tools that pull it into the upstream image. Keep gpgv for apt signatures.
RUN set -eux; \
    . /etc/os-release; \
    test "$VERSION_CODENAME" = bookworm; \
    test "$PG_MAJOR" = 18; \
    apt-get update; \
    apt-get upgrade --yes --no-install-recommends; \
    unused='gnupg gpg gpg-wks-client gpg-wks-server libsqlite3-0'; \
    plan="$(LC_ALL=C apt-get --simulate --no-auto-remove purge $unused)"; \
    removed="$(printf '%s\n' "$plan" | awk '/^(Purg|Remv) / { print $2 }')"; \
    for package in $removed; do \
      case " $unused " in \
        *" $package "*) ;; \
        *) echo "Unexpected package removal: $package" >&2; exit 1 ;; \
      esac; \
    done; \
    apt-get purge --yes --no-auto-remove $unused; \
    for package in $unused; do \
      status="$(dpkg-query -W -f '${db:Status-Status}' "$package" 2>/dev/null || true)"; \
      test -z "$status" || test "$status" = not-installed; \
    done; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*; \
    gpgv --version; \
    gosu --version | grep '^1.20 '; \
    gosu nobody true; \
    postgres --version | grep -E '^postgres \(PostgreSQL\) 18\.'

# Inherit the official entrypoint, stop signal, PGDATA and volume layout.
