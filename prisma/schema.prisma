generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}

enum Role {
  MEMBER
  MODERATOR
}
enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
  LEFT
}
enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}
enum ProposalType {
  FUNDING
  FUNDRAISING
  ADMISSION
  REMOVAL
  GOVERNANCE
  SUSPENSION_REVIEW
}
enum ProposalStatus {
  DRAFT
  OPEN
  CLOSED
  APPROVED
  REJECTED
  EXECUTED
  CANCELLED
}
enum VoteChoice {
  YES
  NO
  ABSTAIN
}
enum TransactionStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  FAILED
}

enum FundingRoundStatus {
  DRAFT
  SUBMISSIONS
  SCREENING
  SELECTION
  DECIDED
  CANCELLED
}

enum SchemeStatus {
  SUBMITTED
  QUALIFIED
  REJECTED
}

model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  username String @unique
  displayName String
  avatarUrl String?
  passwordHash String
  createdAt DateTime @default(now())
  sessions Session[]
  communities Community[]
  memberships CommunityMembership[]
  applications MembershipApplication[]
  proposals Proposal[]
  votes Vote[]
  eligibility EligibleVoter[]
  transactions LedgerTransaction[]
  auditEvents AuditEvent[]
  notifications Notification[]
  dashboardPreference DashboardPreference?
  savedAnalyticsViews SavedAnalyticsView[]
  fundingRounds FundingRound[]
  fundingSchemes FundingScheme[]
  roundEligibility RoundElectorate[]
  screeningBallots SchemeScreeningVote[]
  selectionBallots RoundSelectionVote[]
  roundAccounts RoundAccount[] @relation("RoundAccountOwner")
  roundContributions RoundContribution[]
  roundLedgerTransactions RoundLedgerTransaction[]
  roundOperations RoundOperation[] @relation("RoundBeneficiary")
  roundVotingPowers RoundVotingPower[]
  roundVetoVotes RoundVetoVote[]
  methodBallots RoundMethodBallot[]
  reputationAuthored ReputationReview[] @relation("ReputationAuthor")
  reputationModerated ReputationModeration[] @relation("ReputationModerator")
  reputationReported ReputationReport[] @relation("ReputationReporter")
  reputationAppealed ReputationAppeal[] @relation("ReputationAppellant")
  roundTemplates RoundTemplate[]
  walletChallenges WalletChallenge[]
  walletLinks WalletLink[]
  chainVaults ChainVault[]
  chainOperations ChainOperation[]
  externalPaymentsRecorded ExternalPaymentRecord[] @relation("PaymentRecorder")
  externalPaymentsReceived ExternalPaymentRecord[] @relation("PaymentCounterparty")
}
model Session {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique
  userId String @db.Uuid
  user User @relation(fields:[userId], references:[id], onDelete:Restrict)
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  reauthenticatedAt DateTime?
  @@index([userId, expiresAt])
}
model Community {
  id String @id @default(uuid()) @db.Uuid
  slug String @unique
  name String
  description String
  purpose String
  imageUrl String?
  color String @default("teal")
  currency String @default("USD")
  adminId String @db.Uuid
  admin User @relation(fields:[adminId], references:[id], onDelete:Restrict)
  minimumContribution BigInt @default(0)
  governanceProfile String @default("LEGACY")
  createdAt DateTime @default(now())
  policy GovernancePolicy?
  memberships CommunityMembership[]
  questions MembershipQuestion[]
  applications MembershipApplication[]
  proposals Proposal[]
  accounts TreasuryAccount[]
  transactions LedgerTransaction[]
  auditEvents AuditEvent[]
  notifications Notification[]
  fundingRounds FundingRound[]
  reputationReviews ReputationReview[]
  roundTemplates RoundTemplate[]
  chainVaults ChainVault[]
  externalPaymentRecords ExternalPaymentRecord[]
  @@index([createdAt])
}
model GovernancePolicy {
  id String @id @default(uuid()) @db.Uuid
  communityId String @unique @db.Uuid
  community Community @relation(fields:[communityId], references:[id], onDelete:Restrict)
  quorumBps Int @default(5000)
  thresholdBps Int @default(5001)
  admissionPolicy String @default("VOTE")
  allowMemberProposals Boolean @default(true)
  votingDays Int @default(7)
}
model CommunityMembership {
  id String @id @default(uuid()) @db.Uuid
  communityId String @db.Uuid
  userId String @db.Uuid
  community Community @relation(fields:[communityId], references:[id], onDelete:Restrict)
  user User @relation(fields:[userId], references:[id], onDelete:Restrict)
  role Role @default(MEMBER)
  status MembershipStatus @default(ACTIVE)
  suspensionReason String?
  joinedAt DateTime @default(now())
  declaredContribution BigInt?
  declaredAt DateTime?
  @@unique([communityId, userId])
  @@index([userId, status])
}
model MembershipQuestion {
  id String @id @default(uuid()) @db.Uuid
  communityId String @db.Uuid
  community Community @relation(fields:[communityId], references:[id], onDelete:Restrict)
  prompt String
  answers MembershipApplicationAnswer[]
}
model MembershipApplication {
  id String @id @default(uuid()) @db.Uuid
  communityId String @db.Uuid
  userId String @db.Uuid
  community Community @relation(fields:[communityId], references:[id], onDelete:Restrict)
  user User @relation(fields:[userId], references:[id], onDelete:Restrict)
  introduction String
  proposedContribution BigInt
  status ApplicationStatus @default(PENDING)
  createdAt DateTime @default(now())
  decidedAt DateTime?
  answers MembershipApplicationAnswer[]
  proposal Proposal?
  @@index([communityId, status])
  @@index([userId])
}
model MembershipApplicationAnswer {
  id String @id @default(uuid()) @db.Uuid
  applicationId String @db.Uuid
  questionId String @db.Uuid
  application MembershipApplication @relation(fields:[applicationId], references:[id], onDelete:Restrict)
  question MembershipQuestion @relation(fields:[questionId], references:[id], onDelete:Restrict)
  answer String
  @@unique([applicationId, questionId])
}
// Existing single-proposal decisions remain independent of multi-scheme FundingRounds.
model Proposal {
  id String @id @default(uuid()) @db.Uuid
  communityId String @db.Uuid
  proposerId String @db.Uuid
  community Community @relation(fields:[communityId], references:[id], onDelete:Restrict)
  proposer User @relation(fields:[proposerId], references:[id], onDelete:Restrict)
  title String
  description String
  type ProposalType
  status ProposalStatus @default(DRAFT)
  amount BigInt @default(0)
  recipient String?
  supportingUrl String?
  targetUserId String? @db.Uuid
  applicationId String? @unique @db.Uuid
  application MembershipApplication? @relation(fields:[applicationId], references:[id], onDelete:Restrict)
  quorumBps Int
  thresholdBps Int
  opensAt DateTime
  closesAt DateTime
  finalizedAt DateTime?
  cancellationReason String?
  governanceChange Json?
  governanceProfile String @default("LEGACY")
  successorId String? @db.Uuid
  createdAt DateTime @default(now())
  eligibleVoters EligibleVoter[]
  votes Vote[]
  transactions LedgerTransaction[]
  execution FundingExecution?
  @@index([communityId, status, closesAt])
}
model EligibleVoter {
  proposalId String @db.Uuid
  userId String @db.Uuid
  proposal Proposal @relation(fields:[proposalId], references:[id], onDelete:Restrict)
  user User @relation(fields:[userId], references:[id], onDelete:Restrict)
  vote Vote?
  @@id([proposalId, userId])
  @@index([userId])
}
model Vote {
  id String @id @default(uuid()) @db.Uuid
  proposalId String @db.Uuid
  userId String @db.Uuid
  proposal Proposal @relation(fields:[proposalId], references:[id], onDelete:Restrict)
  user User @relation(fields:[userId], references:[id], onDelete:Restrict)
  eligibleVoter EligibleVoter @relation(fields:[proposalId, userId], references:[proposalId, userId], onDelete:Restrict)
  choice VoteChoice
  createdAt DateTime @default(now())
  @@unique([proposalId, userId])
}
model TreasuryAccount {
  id String @id @default(uuid()) @db.Uuid
  communityId String @db.Uuid
  community Community @relation(fields:[communityId], references:[id], onDelete:Restrict)
  kind String
  balance BigInt @default(0)
  entries LedgerEntry[]
  outgoing LedgerTransaction[] @relation("SourceAccount")
  incoming LedgerTransaction[] @relation("DestinationAccount")
  @@unique([communityId, kind])
}
model LedgerTransaction {
  id String @id @default(uuid()) @db.Uuid
  communityId String @db.Uuid
  initiatedById String @db.Uuid
  community Community @relation(fields:[communityId], references:[id], onDelete:Restrict)
  initiatedBy User @relation(fields:[initiatedById], references:[id], onDelete:Restrict)
  proposalId String? @db.Uuid
  proposal Proposal? @relation(fields:[proposalId], references:[id], onDelete:Restrict)
  amount BigInt
  currency String
  type String
  status TransactionStatus @default(CONFIRMED)
  idempotencyKey String
  simulated Boolean @default(true)
  network String @default("local-simulation")
  sourceAccount String @db.Uuid
  destinationAccount String @db.Uuid
  source TreasuryAccount @relation("SourceAccount", fields:[sourceAccount], references:[id], onDelete:Restrict)
  destination TreasuryAccount @relation("DestinationAccount", fields:[destinationAccount], references:[id], onDelete:Restrict)
  externalReference String?
  confirmedAt DateTime?
  createdAt DateTime @default(now())
  entries LedgerEntry[]
  execution FundingExecution?
  @@unique([communityId, idempotencyKey])
  @@index([communityId, createdAt])
}
model LedgerEntry {
  id String @id @default(uuid()) @db.Uuid
  transactionId String @db.Uuid
  accountId String @db.Uuid
  transaction LedgerTransaction @relation(fields:[transactionId], references:[id], onDelete:Restrict)
  account TreasuryAccount @relation(fields:[accountId], references:[id], onDelete:Restrict)
  amount BigInt
  @@index([accountId])
}
model FundingExecution {
  id String @id @default(uuid()) @db.Uuid
  proposalId String @unique @db.Uuid
  transactionId String @unique @db.Uuid
  proposal Proposal @relation(fields:[proposalId], references:[id], onDelete:Restrict)
  transaction LedgerTransaction @relation(fields:[transactionId], references:[id], onDelete:Restrict)
  status TransactionStatus @default(CONFIRMED)
  network String @default("local-simulation")
  accountId String?
  transactionHash String?
  confirmedAt DateTime?
}
model AuditEvent {
  id String @id @default(uuid()) @db.Uuid
  communityId String @db.Uuid
  actorId String @db.Uuid
  community Community @relation(fields:[communityId], references:[id], onDelete:Restrict)
  actor User @relation(fields:[actorId], references:[id], onDelete:Restrict)
  action String
  entityId String
  details Json
  createdAt DateTime @default(now())
  @@index([communityId, createdAt])
}
model Notification {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  communityId String @db.Uuid
  user User @relation(fields:[userId], references:[id], onDelete:Restrict)
  community Community @relation(fields:[communityId], references:[id], onDelete:Restrict)
  message String
  href String
  readAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, readAt])
}
model RateLimit {
  key String @id
  count Int @default(1)
  expiresAt DateTime
}

model RoundTemplate {
  id String @id @default(uuid()) @db.Uuid
  communityId String @db.Uuid
  authorId String @db.Uuid
  community Community @relation(fields:[communityId],references:[id],onDelete:Restrict)
  author User @relation(fields:[authorId],references:[id],onDelete:Restrict)
  name String @db.VarChar(120)
  description String
  archivedAt DateTime?
  createdAt DateTime @default(now())
  revisions RoundTemplateRevision[]
  @@index([communityId,createdAt])
}
model RoundTemplateRevision {
  id String @id @default(uuid()) @db.Uuid
  templateId String @db.Uuid
  template RoundTemplate @relation(fields:[templateId],references:[id],onDelete:Restrict)
  number Int
  rules Json
  createdAt DateTime @default(now())
  rounds FundingRound[]
  @@unique([templateId,number])
}
model WalletChallenge {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  sessionHash String
  accountId String
  network String
  origin String
  nonce String @unique
  message String
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId,expiresAt])
}
model WalletLink {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  network String
  accountId String
  publicKey String
  verifiedAt DateTime @default(now())
  revokedAt DateTime?
  @@unique([network,accountId])
  @@index([userId,revokedAt])
}
// Native asset custody is additive and never reuses the fiat/minor-unit ledger.
model ChainVault {
  id String @id @default(uuid()) @db.Uuid
  communityId String @db.Uuid
  creatorId String @db.Uuid
  roundId String @db.Uuid
  community Community @relation(fields:[communityId],references:[id],onDelete:Restrict)
  creator User @relation(fields:[creatorId],references:[id],onDelete:Restrict)
  round FundingRound @relation(fields:[roundId],references:[id],onDelete:Restrict)
  network String @default("testnet")
  provider String @default("near-testnet")
  assetId String @default("near:testnet:NEAR")
  decimals Int @default(24)
  contractId String
  title String
  rulesVersion Int @default(1)
  rulesSnapshot Json
  collectionClosesAt DateTime
  expiresAt DateTime
  vetoEnabled Boolean
  allocationHash String?
  plan Json?
  publishedAt DateTime?
  createdAt DateTime @default(now())
  operations ChainOperation[]
  observations ChainObservation[]
  @@index([communityId,createdAt])
}
model ChainOperation {
  id String @id @default(uuid()) @db.Uuid
  vaultId String @db.Uuid
  vault ChainVault @relation(fields:[vaultId],references:[id],onDelete:Restrict)
  actorId String @db.Uuid
  actor User @relation(fields:[actorId],references:[id],onDelete:Restrict)
  operationKey String @unique
  kind String
  amount Decimal @db.Decimal(78,0)
  recipient String
  method String
  args Json
  attachedDeposit Decimal @db.Decimal(78,0)
  expectedSigner String
  status String @default("PREPARED")
  transactionHash String? @unique
  submittedAt DateTime?
  confirmedAt DateTime?
  createdAt DateTime @default(now())
  observations ChainObservation[]
  @@index([vaultId,status])
}
model ChainObservation {
  id String @id @default(uuid()) @db.Uuid
  vaultId String @db.Uuid
  operationId String @db.Uuid
  vault ChainVault @relation(fields:[vaultId],references:[id],onDelete:Restrict)
  operation ChainOperation @relation(fields:[operationId],references:[id],onDelete:Restrict)
  rpcUrl String
  transactionHash String
  finality String
  status String
  receiptIds Json
  evidence Json
  observedAt DateTime @default(now())
  @@index([vaultId,observedAt])
}

model DashboardPreference {
  userId String @id @db.Uuid
  user User @relation(fields:[userId], references:[id], onDelete:Restrict)
  widgets Json
  updatedAt DateTime @updatedAt
}
model SavedAnalyticsView {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId], references:[id], onDelete:Restrict)
  name String
  filters Json
  createdAt DateTime @default(now())
  @@unique([userId,name])
  @@index([userId,createdAt])
}

model FundingRound {
  id String @id @default(uuid()) @db.Uuid
  communityId String @db.Uuid
  creatorId String @db.Uuid
  community Community @relation(fields:[communityId], references:[id], onDelete:Restrict)
  creator User @relation(fields:[creatorId], references:[id], onDelete:Restrict)
  title String
  description String
  proposalPolicy String @default("MEMBERS")
  quorumBps Int @default(5000)
  status FundingRoundStatus @default(DRAFT)
  submissionsCloseAt DateTime
  screeningOpensAt DateTime?
  screeningClosesAt DateTime?
  selectionOpensAt DateTime?
  selectionClosesAt DateTime?
  decidedAt DateTime?
  outcome String?
  winnerSchemeId String? @db.Uuid
  createdAt DateTime @default(now())
  rulesVersion Int @default(1)
  settlement RoundSettlement?
  schemes FundingScheme[]
  electorate RoundElectorate[]
  screeningVotes SchemeScreeningVote[]
  selectionVotes RoundSelectionVote[]
  powers RoundVotingPower[]
  decision RoundDecision?
  vetoVotes RoundVetoVote[]
  methodBallots RoundMethodBallot[]
  templateRevisionId String? @db.Uuid
  templateRevision RoundTemplateRevision? @relation(fields:[templateRevisionId],references:[id],onDelete:Restrict)
  chainVaults ChainVault[]
  externalPaymentRecords ExternalPaymentRecord[]
  @@index([communityId,createdAt])
}

model RoundVotingPower {
  roundId String @db.Uuid
  userId String @db.Uuid
  round FundingRound @relation(fields:[roundId],references:[id],onDelete:Restrict)
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  eligible Boolean @default(true)
  paidPower BigInt @default(0)
  frozenAt DateTime?
  createdAt DateTime @default(now())
  vetoVotes RoundVetoVote[]
  @@id([roundId,userId])
}

model RoundDecision {
  roundId String @id @db.Uuid
  round FundingRound @relation(fields:[roundId],references:[id],onDelete:Restrict)
  publishedAt DateTime
  allocation Json
  result Json
  vetoClosesAt DateTime?
  vetoFinalizedAt DateTime?
  rejected Boolean @default(false)
  totalVetoPower BigInt
}

model RoundVetoVote {
  id String @id @default(uuid()) @db.Uuid
  roundId String @db.Uuid
  userId String @db.Uuid
  round FundingRound @relation(fields:[roundId],references:[id],onDelete:Restrict)
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  voter RoundVotingPower @relation(fields:[roundId,userId],references:[roundId,userId],onDelete:Restrict)
  choice String
  createdAt DateTime @default(now())
  @@unique([roundId,userId])
}

model FundingScheme {
  id String @id @default(uuid()) @db.Uuid
  roundId String @db.Uuid
  authorId String @db.Uuid
  round FundingRound @relation(fields:[roundId], references:[id], onDelete:Restrict)
  author User @relation(fields:[authorId], references:[id], onDelete:Restrict)
  title String
  description String
  amount BigInt
  recipient String
  supportingUrl String?
  status SchemeStatus @default(SUBMITTED)
  category String @default("UNSPECIFIED")
  createdAt DateTime @default(now())
  screeningVotes SchemeScreeningVote[]
  selectionVotes RoundSelectionVote[]
  operations RoundOperation[]
  @@unique([roundId,id])
  @@index([roundId,createdAt])
}

model RoundElectorate {
  roundId String @db.Uuid
  userId String @db.Uuid
  round FundingRound @relation(fields:[roundId], references:[id], onDelete:Restrict)
  user User @relation(fields:[userId], references:[id], onDelete:Restrict)
  screeningVotes SchemeScreeningVote[]
  selectionVote RoundSelectionVote?
  methodBallot RoundMethodBallot?
  @@id([roundId,userId])
}

model RoundMethodBallot {
  id String @id @default(uuid()) @db.Uuid
  roundId String @db.Uuid
  userId String @db.Uuid
  round FundingRound @relation(fields:[roundId],references:[id],onDelete:Restrict)
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  voter RoundElectorate @relation(fields:[roundId,userId],references:[roundId,userId],onDelete:Restrict)
  method String
  ballot Json
  createdAt DateTime @default(now())
  @@unique([roundId,userId])
}

model ReputationReview {
  id String @id @default(uuid()) @db.Uuid
  communityId String @db.Uuid
  community Community @relation(fields:[communityId],references:[id],onDelete:Restrict)
  authorId String @db.Uuid
  author User @relation("ReputationAuthor",fields:[authorId],references:[id],onDelete:Restrict)
  targetType String
  targetId String @db.Uuid
  dimension String
  contextType String
  contextId String @db.Uuid
  createdAt DateTime @default(now())
  revisions ReputationRevision[]
  moderations ReputationModeration[]
  reports ReputationReport[]
  appeals ReputationAppeal[]
  @@unique([communityId,authorId,targetType,targetId,dimension])
  @@index([communityId,createdAt])
}

model ReputationRevision {
  id String @id @default(uuid()) @db.Uuid
  reviewId String @db.Uuid
  review ReputationReview @relation(fields:[reviewId],references:[id],onDelete:Restrict)
  revision Int
  score Int
  text String
  createdAt DateTime @default(now())
  @@unique([reviewId,revision])
}

model ReputationModeration {
  id String @id @default(uuid()) @db.Uuid
  reviewId String @db.Uuid
  review ReputationReview @relation(fields:[reviewId],references:[id],onDelete:Restrict)
  actorId String @db.Uuid
  actor User @relation("ReputationModerator",fields:[actorId],references:[id],onDelete:Restrict)
  sequence Int
  action String
  reason String
  createdAt DateTime @default(now())
  appeal ReputationAppeal?
  @@unique([reviewId,sequence])
}

model ReputationReport {
  id String @id @default(uuid()) @db.Uuid
  reviewId String @db.Uuid
  review ReputationReview @relation(fields:[reviewId],references:[id],onDelete:Restrict)
  reporterId String @db.Uuid
  reporter User @relation("ReputationReporter",fields:[reporterId],references:[id],onDelete:Restrict)
  reason String
  createdAt DateTime @default(now())
  @@unique([reviewId,reporterId])
}

model ReputationAppeal {
  id String @id @default(uuid()) @db.Uuid
  reviewId String @db.Uuid
  review ReputationReview @relation(fields:[reviewId],references:[id],onDelete:Restrict)
  moderationId String @unique @db.Uuid
  moderation ReputationModeration @relation(fields:[moderationId],references:[id],onDelete:Restrict)
  authorId String @db.Uuid
  author User @relation("ReputationAppellant",fields:[authorId],references:[id],onDelete:Restrict)
  statement String
  createdAt DateTime @default(now())
}

model SchemeScreeningVote {
  id String @id @default(uuid()) @db.Uuid
  roundId String @db.Uuid
  schemeId String @db.Uuid
  userId String @db.Uuid
  round FundingRound @relation(fields:[roundId], references:[id], onDelete:Restrict)
  scheme FundingScheme @relation(fields:[roundId,schemeId], references:[roundId,id], onDelete:Restrict)
  voter RoundElectorate @relation(fields:[roundId,userId], references:[roundId,userId], onDelete:Restrict)
  user User @relation(fields:[userId], references:[id], onDelete:Restrict)
  choice VoteChoice
  createdAt DateTime @default(now())
  @@unique([schemeId,userId])
  @@index([roundId])
}

model RoundSelectionVote {
  id String @id @default(uuid()) @db.Uuid
  roundId String @db.Uuid
  schemeId String @db.Uuid
  userId String @db.Uuid
  round FundingRound @relation(fields:[roundId], references:[id], onDelete:Restrict)
  scheme FundingScheme @relation(fields:[roundId,schemeId], references:[roundId,id], onDelete:Restrict)
  voter RoundElectorate @relation(fields:[roundId,userId], references:[roundId,userId], onDelete:Restrict)
  user User @relation(fields:[userId], references:[id], onDelete:Restrict)
  createdAt DateTime @default(now())
  @@unique([roundId,userId])
}

model RoundSettlement {
  roundId String @id @db.Uuid
  round FundingRound @relation(fields:[roundId],references:[id],onDelete:Restrict)
  rulesVersion Int @default(2)
  assetId String
  currency String
  decimals Int @default(2)
  network String @default("local-simulation")
  status String @default("DRAFT")
  fundingTarget BigInt
  minimumContribution BigInt
  maximumContribution BigInt
  collectionClosesAt DateTime
  expiresAt DateTime
  rulesSnapshot Json
  contributionSnapshot Json?
  frozenAt DateTime?
  received BigInt @default(0)
  paid BigInt @default(0)
  refunded BigInt @default(0)
  allocationSnapshot Json?
  preparedAt DateTime?
  settledAt DateTime?
  reason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  accounts RoundAccount[]
  transactions RoundLedgerTransaction[]
  contributions RoundContribution[]
  operations RoundOperation[]
}

model RoundAccount {
  id String @id @default(uuid()) @db.Uuid
  roundId String @db.Uuid
  settlement RoundSettlement @relation(fields:[roundId],references:[roundId],onDelete:Restrict)
  key String
  ownerId String? @db.Uuid
  owner User? @relation("RoundAccountOwner",fields:[ownerId],references:[id],onDelete:Restrict)
  balance BigInt @default(0)
  entries RoundLedgerEntry[]
  outgoing RoundLedgerTransaction[] @relation("RoundLedgerSource")
  incoming RoundLedgerTransaction[] @relation("RoundLedgerDestination")
  contributions RoundContribution[]
  sourceOperations RoundOperation[] @relation("RoundOperationSource")
  destinationOperations RoundOperation[] @relation("RoundOperationDestination")
  @@unique([roundId,key])
  @@unique([roundId,id])
}

model RoundLedgerTransaction {
  id String @id @default(uuid()) @db.Uuid
  roundId String @db.Uuid
  settlement RoundSettlement @relation(fields:[roundId],references:[roundId],onDelete:Restrict)
  operationKey String
  kind String
  amount BigInt
  assetId String
  initiatedById String @db.Uuid
  initiatedBy User @relation(fields:[initiatedById],references:[id],onDelete:Restrict)
  sourceAccountId String @db.Uuid
  destinationAccountId String @db.Uuid
  source RoundAccount @relation("RoundLedgerSource",fields:[sourceAccountId],references:[id],onDelete:Restrict)
  destination RoundAccount @relation("RoundLedgerDestination",fields:[destinationAccountId],references:[id],onDelete:Restrict)
  createdAt DateTime @default(now())
  entries RoundLedgerEntry[]
  contribution RoundContribution?
  operation RoundOperation?
  @@unique([roundId,operationKey])
}

model RoundLedgerEntry {
  id String @id @default(uuid()) @db.Uuid
  transactionId String @db.Uuid
  accountId String @db.Uuid
  transaction RoundLedgerTransaction @relation(fields:[transactionId],references:[id],onDelete:Restrict)
  account RoundAccount @relation(fields:[accountId],references:[id],onDelete:Restrict)
  amount BigInt
  @@index([accountId])
}

model RoundContribution {
  id String @id @default(uuid()) @db.Uuid
  roundId String @db.Uuid
  userId String @db.Uuid
  sourceAccountId String @db.Uuid
  transactionId String @unique @db.Uuid
  settlement RoundSettlement @relation(fields:[roundId],references:[roundId],onDelete:Restrict)
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  sourceAccount RoundAccount @relation(fields:[sourceAccountId],references:[id],onDelete:Restrict)
  transaction RoundLedgerTransaction @relation(fields:[transactionId],references:[id],onDelete:Restrict)
  amount BigInt
  createdAt DateTime @default(now())
  @@index([roundId,userId])
}

model RoundOperation {
  id String @id @default(uuid()) @db.Uuid
  roundId String @db.Uuid
  operationKey String
  kind String
  amount BigInt
  beneficiaryId String? @db.Uuid
  sourceAccountId String @db.Uuid
  destinationAccountId String @db.Uuid
  recipient String
  schemeId String? @db.Uuid
  status String @default("PENDING")
  attempts Int @default(0)
  lastError String?
  transactionId String? @unique @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completedAt DateTime?
  settlement RoundSettlement @relation(fields:[roundId],references:[roundId],onDelete:Restrict)
  beneficiary User? @relation("RoundBeneficiary",fields:[beneficiaryId],references:[id],onDelete:Restrict)
  source RoundAccount @relation("RoundOperationSource",fields:[sourceAccountId],references:[id],onDelete:Restrict)
  destination RoundAccount @relation("RoundOperationDestination",fields:[destinationAccountId],references:[id],onDelete:Restrict)
  scheme FundingScheme? @relation(fields:[schemeId],references:[id],onDelete:Restrict)
  transaction RoundLedgerTransaction? @relation(fields:[transactionId],references:[id],onDelete:Restrict)
  executionAttempts RoundExecutionAttempt[]
  @@unique([roundId,operationKey])
  @@index([roundId,status])
}

model RoundExecutionAttempt {
  id String @id @default(uuid()) @db.Uuid
  operationId String @db.Uuid
  operation RoundOperation @relation(fields:[operationId],references:[id],onDelete:Restrict)
  attempt Int
  status String
  error String?
  createdAt DateTime @default(now())
  @@unique([operationId,attempt])
}

// Staff attestations about external payments; never a custody or voting-power source.
model ExternalPaymentRecord {
  id String @id @default(uuid()) @db.Uuid
  communityId String @db.Uuid
  roundId String? @db.Uuid
  recordedById String @db.Uuid
  counterpartyId String? @db.Uuid
  kind String
  amount BigInt
  currency String
  reference String @db.VarChar(120)
  note String @db.VarChar(2000)
  evidenceUrl String? @db.VarChar(2048)
  occurredAt DateTime
  createdAt DateTime @default(dbgenerated("timezone('UTC'::text, clock_timestamp())"))
  reversesId String? @unique @db.Uuid
  community Community @relation(fields:[communityId],references:[id],onDelete:Restrict)
  round FundingRound? @relation(fields:[roundId],references:[id],onDelete:Restrict)
  recordedBy User @relation("PaymentRecorder",fields:[recordedById],references:[id],onDelete:Restrict)
  counterparty User? @relation("PaymentCounterparty",fields:[counterpartyId],references:[id],onDelete:Restrict)
  reverses ExternalPaymentRecord? @relation("PaymentReversal",fields:[reversesId],references:[id],onDelete:Restrict)
  reversal ExternalPaymentRecord? @relation("PaymentReversal")
  @@unique([communityId,reference])
  @@index([communityId,createdAt])
}
