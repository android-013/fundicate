generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}

enum Role {
  MEMBER
  MODERATOR
}
enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
  LEFT
}
enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}
enum ProposalType {
  FUNDING
  FUNDRAISING
  ADMISSION
  REMOVAL
  GOVERNANCE
  SUSPENSION_REVIEW
}
enum ProposalStatus {
  DRAFT
  OPEN
  CLOSED
  APPROVED
  REJECTED
  EXECUTED
  CANCELLED
}
enum VoteChoice {
  YES
  NO
  ABSTAIN
}
enum TransactionStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  FAILED
}

enum FundingRoundStatus {
  DRAFT
  SUBMISSIONS
  SCREENING
  SELECTION
  DECIDED
  CANCELLED
}

enum SchemeStatus {
  SUBMITTED
  QUALIFIED
  REJECTED
}

model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  username String @unique
  displayName String
  avatarUrl String?
  passwordHash String
  createdAt DateTime @default(now())
  sessions Session[]
  communities Community[]
  memberships CommunityMembership[]
  applications MembershipApplication[]
  proposals Proposal[]
  votes Vote[]
  eligibility EligibleVoter[]
  transactions LedgerTransaction[]
  auditEvents AuditEvent[]
  notifications Notification[]
  dashboardPreference DashboardPreference?
  savedAnalyticsViews SavedAnalyticsView[]
  fundingRounds FundingRound[]
  fundingSchemes FundingScheme[]
  roundEligibility RoundElectorate[]
  screeningBallots SchemeScreeningVote[]
  selectionBallots RoundSelectionVote[]
  roundAccounts RoundAccount[] @relation("RoundAccountOwner")
  roundContributions RoundContribution[]
  roundLedgerTransactions RoundLedgerTransaction[]
  roundOperations RoundOperation[] @relation("RoundBeneficiary")
}
model Session {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique
  userId String @db.Uuid
  user User @relation(fields:[userId], references:[id], onDelete:Restrict)
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  @@index([userId, expiresAt])
}
model Community {
  id String @id @default(uuid()) @db.Uuid
  slug String @unique
  name String
  description String
  purpose String
  imageUrl String?
  color String @default("teal")
  currency String @default("USD")
  adminId String @db.Uuid
  admin User @relation(fields:[adminId], references:[id], onDelete:Restrict)
  minimumContribution BigInt @default(0)
  governanceProfile String @default("LEGACY")
  createdAt DateTime @default(now())
  policy GovernancePolicy?
  memberships CommunityMembership[]
  questions MembershipQuestion[]
  applications MembershipApplication[]
  proposals Proposal[]
  accounts TreasuryAccount[]
  transactions LedgerTransaction[]
  auditEvents AuditEvent[]
  notifications Notification[]
  fundingRounds FundingRound[]
  @@index([createdAt])
}
model GovernancePolicy {
  id String @id @default(uuid()) @db.Uuid
  communityId String @unique @db.Uuid
  community Community @relation(fields:[communityId], references:[id], onDelete:Restrict)
  quorumBps Int @default(5000)
  thresholdBps Int @default(5001)
  admissionPolicy String @default("VOTE")
  allowMemberProposals Boolean @default(true)
  votingDays Int @default(7)
}
model CommunityMembership {
  id String @id @default(uuid()) @db.Uuid
  communityId String @db.Uuid
  userId String @db.Uuid
  community Community @relation(fields:[communityId], references:[id], onDelete:Restrict)
  user User @relation(fields:[userId], references:[id], onDelete:Restrict)
  role Role @default(MEMBER)
  status MembershipStatus @default(ACTIVE)
  suspensionReason String?
  joinedAt DateTime @default(now())
  declaredContribution BigInt?
  declaredAt DateTime?
  @@unique([communityId, userId])
  @@index([userId, status])
}
model MembershipQuestion {
  id String @id @default(uuid()) @db.Uuid
  communityId String @db.Uuid
  community Community @relation(fields:[communityId], references:[id], onDelete:Restrict)
  prompt String
  answers MembershipApplicationAnswer[]
}
model MembershipApplication {
  id String @id @default(uuid()) @db.Uuid
  communityId String @db.Uuid
  userId String @db.Uuid
  community Community @relation(fields:[communityId], references:[id], onDelete:Restrict)
  user User @relation(fields:[userId], references:[id], onDelete:Restrict)
  introduction String
  proposedContribution BigInt
  status ApplicationStatus @default(PENDING)
  createdAt DateTime @default(now())
  decidedAt DateTime?
  answers MembershipApplicationAnswer[]
  proposal Proposal?
  @@index([communityId, status])
  @@index([userId])
}
model MembershipApplicationAnswer {
  id String @id @default(uuid()) @db.Uuid
  applicationId String @db.Uuid
  questionId String @db.Uuid
  application MembershipApplication @relation(fields:[applicationId], references:[id], onDelete:Restrict)
  question MembershipQuestion @relation(fields:[questionId], references:[id], onDelete:Restrict)
  answer String
  @@unique([applicationId, questionId])
}
// Existing single-proposal decisions remain independent of multi-scheme FundingRounds.
model Proposal {
  id String @id @default(uuid()) @db.Uuid
  communityId String @db.Uuid
  proposerId String @db.Uuid
  community Community @relation(fields:[communityId], references:[id], onDelete:Restrict)
  proposer User @relation(fields:[proposerId], references:[id], onDelete:Restrict)
  title String
  description String
  type ProposalType
  status ProposalStatus @default(DRAFT)
  amount BigInt @default(0)
  recipient String?
  supportingUrl String?
  targetUserId String? @db.Uuid
  applicationId String? @unique @db.Uuid
  application MembershipApplication? @relation(fields:[applicationId], references:[id], onDelete:Restrict)
  quorumBps Int
  thresholdBps Int
  opensAt DateTime
  closesAt DateTime
  finalizedAt DateTime?
  cancellationReason String?
  governanceChange Json?
  governanceProfile String @default("LEGACY")
  successorId String? @db.Uuid
  createdAt DateTime @default(now())
  eligibleVoters EligibleVoter[]
  votes Vote[]
  transactions LedgerTransaction[]
  execution FundingExecution?
  @@index([communityId, status, closesAt])
}
model EligibleVoter {
  proposalId String @db.Uuid
  userId String @db.Uuid
  proposal Proposal @relation(fields:[proposalId], references:[id], onDelete:Restrict)
  user User @relation(fields:[userId], references:[id], onDelete:Restrict)
  vote Vote?
  @@id([proposalId, userId])
  @@index([userId])
}
model Vote {
  id String @id @default(uuid()) @db.Uuid
  proposalId String @db.Uuid
  userId String @db.Uuid
  proposal Proposal @relation(fields:[proposalId], references:[id], onDelete:Restrict)
  user User @relation(fields:[userId], references:[id], onDelete:Restrict)
  eligibleVoter EligibleVoter @relation(fields:[proposalId, userId], references:[proposalId, userId], onDelete:Restrict)
  choice VoteChoice
  createdAt DateTime @default(now())
  @@unique([proposalId, userId])
}
model TreasuryAccount {
  id String @id @default(uuid()) @db.Uuid
  communityId String @db.Uuid
  community Community @relation(fields:[communityId], references:[id], onDelete:Restrict)
  kind String
  balance BigInt @default(0)
  entries LedgerEntry[]
  outgoing LedgerTransaction[] @relation("SourceAccount")
  incoming LedgerTransaction[] @relation("DestinationAccount")
  @@unique([communityId, kind])
}
model LedgerTransaction {
  id String @id @default(uuid()) @db.Uuid
  communityId String @db.Uuid
  initiatedById String @db.Uuid
  community Community @relation(fields:[communityId], references:[id], onDelete:Restrict)
  initiatedBy User @relation(fields:[initiatedById], references:[id], onDelete:Restrict)
  proposalId String? @db.Uuid
  proposal Proposal? @relation(fields:[proposalId], references:[id], onDelete:Restrict)
  amount BigInt
  currency String
  type String
  status TransactionStatus @default(CONFIRMED)
  idempotencyKey String
  simulated Boolean @default(true)
  network String @default("local-simulation")
  sourceAccount String @db.Uuid
  destinationAccount String @db.Uuid
  source TreasuryAccount @relation("SourceAccount", fields:[sourceAccount], references:[id], onDelete:Restrict)
  destination TreasuryAccount @relation("DestinationAccount", fields:[destinationAccount], references:[id], onDelete:Restrict)
  externalReference String?
  confirmedAt DateTime?
  createdAt DateTime @default(now())
  entries LedgerEntry[]
  execution FundingExecution?
  @@unique([communityId, idempotencyKey])
  @@index([communityId, createdAt])
}
model LedgerEntry {
  id String @id @default(uuid()) @db.Uuid
  transactionId String @db.Uuid
  accountId String @db.Uuid
  transaction LedgerTransaction @relation(fields:[transactionId], references:[id], onDelete:Restrict)
  account TreasuryAccount @relation(fields:[accountId], references:[id], onDelete:Restrict)
  amount BigInt
  @@index([accountId])
}
model FundingExecution {
  id String @id @default(uuid()) @db.Uuid
  proposalId String @unique @db.Uuid
  transactionId String @unique @db.Uuid
  proposal Proposal @relation(fields:[proposalId], references:[id], onDelete:Restrict)
  transaction LedgerTransaction @relation(fields:[transactionId], references:[id], onDelete:Restrict)
  status TransactionStatus @default(CONFIRMED)
  network String @default("local-simulation")
  accountId String?
  transactionHash String?
  confirmedAt DateTime?
}
model AuditEvent {
  id String @id @default(uuid()) @db.Uuid
  communityId String @db.Uuid
  actorId String @db.Uuid
  community Community @relation(fields:[communityId], references:[id], onDelete:Restrict)
  actor User @relation(fields:[actorId], references:[id], onDelete:Restrict)
  action String
  entityId String
  details Json
  createdAt DateTime @default(now())
  @@index([communityId, createdAt])
}
model Notification {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  communityId String @db.Uuid
  user User @relation(fields:[userId], references:[id], onDelete:Restrict)
  community Community @relation(fields:[communityId], references:[id], onDelete:Restrict)
  message String
  href String
  readAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, readAt])
}
model RateLimit {
  key String @id
  count Int @default(1)
  expiresAt DateTime
}

model DashboardPreference {
  userId String @id @db.Uuid
  user User @relation(fields:[userId], references:[id], onDelete:Restrict)
  widgets Json
  updatedAt DateTime @updatedAt
}
model SavedAnalyticsView {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId], references:[id], onDelete:Restrict)
  name String
  filters Json
  createdAt DateTime @default(now())
  @@unique([userId,name])
  @@index([userId,createdAt])
}

model FundingRound {
  id String @id @default(uuid()) @db.Uuid
  communityId String @db.Uuid
  creatorId String @db.Uuid
  community Community @relation(fields:[communityId], references:[id], onDelete:Restrict)
  creator User @relation(fields:[creatorId], references:[id], onDelete:Restrict)
  title String
  description String
  proposalPolicy String @default("MEMBERS")
  quorumBps Int @default(5000)
  status FundingRoundStatus @default(DRAFT)
  submissionsCloseAt DateTime
  screeningOpensAt DateTime?
  screeningClosesAt DateTime?
  selectionOpensAt DateTime?
  selectionClosesAt DateTime?
  decidedAt DateTime?
  outcome String?
  winnerSchemeId String? @db.Uuid
  createdAt DateTime @default(now())
  rulesVersion Int @default(1)
  settlement RoundSettlement?
  schemes FundingScheme[]
  electorate RoundElectorate[]
  screeningVotes SchemeScreeningVote[]
  selectionVotes RoundSelectionVote[]
  @@index([communityId,createdAt])
}

model FundingScheme {
  id String @id @default(uuid()) @db.Uuid
  roundId String @db.Uuid
  authorId String @db.Uuid
  round FundingRound @relation(fields:[roundId], references:[id], onDelete:Restrict)
  author User @relation(fields:[authorId], references:[id], onDelete:Restrict)
  title String
  description String
  amount BigInt
  recipient String
  supportingUrl String?
  status SchemeStatus @default(SUBMITTED)
  category String @default("UNSPECIFIED")
  createdAt DateTime @default(now())
  screeningVotes SchemeScreeningVote[]
  selectionVotes RoundSelectionVote[]
  operations RoundOperation[]
  @@unique([roundId,id])
  @@index([roundId,createdAt])
}

model RoundElectorate {
  roundId String @db.Uuid
  userId String @db.Uuid
  round FundingRound @relation(fields:[roundId], references:[id], onDelete:Restrict)
  user User @relation(fields:[userId], references:[id], onDelete:Restrict)
  screeningVotes SchemeScreeningVote[]
  selectionVote RoundSelectionVote?
  @@id([roundId,userId])
}

model SchemeScreeningVote {
  id String @id @default(uuid()) @db.Uuid
  roundId String @db.Uuid
  schemeId String @db.Uuid
  userId String @db.Uuid
  round FundingRound @relation(fields:[roundId], references:[id], onDelete:Restrict)
  scheme FundingScheme @relation(fields:[roundId,schemeId], references:[roundId,id], onDelete:Restrict)
  voter RoundElectorate @relation(fields:[roundId,userId], references:[roundId,userId], onDelete:Restrict)
  user User @relation(fields:[userId], references:[id], onDelete:Restrict)
  choice VoteChoice
  createdAt DateTime @default(now())
  @@unique([schemeId,userId])
  @@index([roundId])
}

model RoundSelectionVote {
  id String @id @default(uuid()) @db.Uuid
  roundId String @db.Uuid
  schemeId String @db.Uuid
  userId String @db.Uuid
  round FundingRound @relation(fields:[roundId], references:[id], onDelete:Restrict)
  scheme FundingScheme @relation(fields:[roundId,schemeId], references:[roundId,id], onDelete:Restrict)
  voter RoundElectorate @relation(fields:[roundId,userId], references:[roundId,userId], onDelete:Restrict)
  user User @relation(fields:[userId], references:[id], onDelete:Restrict)
  createdAt DateTime @default(now())
  @@unique([roundId,userId])
}

model RoundSettlement {
  roundId String @id @db.Uuid
  round FundingRound @relation(fields:[roundId],references:[id],onDelete:Restrict)
  rulesVersion Int @default(2)
  assetId String
  currency String
  decimals Int @default(2)
  network String @default("local-simulation")
  status String @default("DRAFT")
  fundingTarget BigInt
  minimumContribution BigInt
  maximumContribution BigInt
  collectionClosesAt DateTime
  expiresAt DateTime
  rulesSnapshot Json
  contributionSnapshot Json?
  frozenAt DateTime?
  received BigInt @default(0)
  paid BigInt @default(0)
  refunded BigInt @default(0)
  allocationSnapshot Json?
  preparedAt DateTime?
  settledAt DateTime?
  reason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  accounts RoundAccount[]
  transactions RoundLedgerTransaction[]
  contributions RoundContribution[]
  operations RoundOperation[]
}

model RoundAccount {
  id String @id @default(uuid()) @db.Uuid
  roundId String @db.Uuid
  settlement RoundSettlement @relation(fields:[roundId],references:[roundId],onDelete:Restrict)
  key String
  ownerId String? @db.Uuid
  owner User? @relation("RoundAccountOwner",fields:[ownerId],references:[id],onDelete:Restrict)
  balance BigInt @default(0)
  entries RoundLedgerEntry[]
  outgoing RoundLedgerTransaction[] @relation("RoundLedgerSource")
  incoming RoundLedgerTransaction[] @relation("RoundLedgerDestination")
  contributions RoundContribution[]
  sourceOperations RoundOperation[] @relation("RoundOperationSource")
  destinationOperations RoundOperation[] @relation("RoundOperationDestination")
  @@unique([roundId,key])
  @@unique([roundId,id])
}

model RoundLedgerTransaction {
  id String @id @default(uuid()) @db.Uuid
  roundId String @db.Uuid
  settlement RoundSettlement @relation(fields:[roundId],references:[roundId],onDelete:Restrict)
  operationKey String
  kind String
  amount BigInt
  assetId String
  initiatedById String @db.Uuid
  initiatedBy User @relation(fields:[initiatedById],references:[id],onDelete:Restrict)
  sourceAccountId String @db.Uuid
  destinationAccountId String @db.Uuid
  source RoundAccount @relation("RoundLedgerSource",fields:[sourceAccountId],references:[id],onDelete:Restrict)
  destination RoundAccount @relation("RoundLedgerDestination",fields:[destinationAccountId],references:[id],onDelete:Restrict)
  createdAt DateTime @default(now())
  entries RoundLedgerEntry[]
  contribution RoundContribution?
  operation RoundOperation?
  @@unique([roundId,operationKey])
}

model RoundLedgerEntry {
  id String @id @default(uuid()) @db.Uuid
  transactionId String @db.Uuid
  accountId String @db.Uuid
  transaction RoundLedgerTransaction @relation(fields:[transactionId],references:[id],onDelete:Restrict)
  account RoundAccount @relation(fields:[accountId],references:[id],onDelete:Restrict)
  amount BigInt
  @@index([accountId])
}

model RoundContribution {
  id String @id @default(uuid()) @db.Uuid
  roundId String @db.Uuid
  userId String @db.Uuid
  sourceAccountId String @db.Uuid
  transactionId String @unique @db.Uuid
  settlement RoundSettlement @relation(fields:[roundId],references:[roundId],onDelete:Restrict)
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  sourceAccount RoundAccount @relation(fields:[sourceAccountId],references:[id],onDelete:Restrict)
  transaction RoundLedgerTransaction @relation(fields:[transactionId],references:[id],onDelete:Restrict)
  amount BigInt
  createdAt DateTime @default(now())
  @@index([roundId,userId])
}

model RoundOperation {
  id String @id @default(uuid()) @db.Uuid
  roundId String @db.Uuid
  operationKey String
  kind String
  amount BigInt
  beneficiaryId String? @db.Uuid
  sourceAccountId String @db.Uuid
  destinationAccountId String @db.Uuid
  recipient String
  schemeId String? @db.Uuid
  status String @default("PENDING")
  attempts Int @default(0)
  lastError String?
  transactionId String? @unique @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completedAt DateTime?
  settlement RoundSettlement @relation(fields:[roundId],references:[roundId],onDelete:Restrict)
  beneficiary User? @relation("RoundBeneficiary",fields:[beneficiaryId],references:[id],onDelete:Restrict)
  source RoundAccount @relation("RoundOperationSource",fields:[sourceAccountId],references:[id],onDelete:Restrict)
  destination RoundAccount @relation("RoundOperationDestination",fields:[destinationAccountId],references:[id],onDelete:Restrict)
  scheme FundingScheme? @relation(fields:[schemeId],references:[id],onDelete:Restrict)
  transaction RoundLedgerTransaction? @relation(fields:[transactionId],references:[id],onDelete:Restrict)
  executionAttempts RoundExecutionAttempt[]
  @@unique([roundId,operationKey])
  @@index([roundId,status])
}

model RoundExecutionAttempt {
  id String @id @default(uuid()) @db.Uuid
  operationId String @db.Uuid
  operation RoundOperation @relation(fields:[operationId],references:[id],onDelete:Restrict)
  attempt Int
  status String
  error String?
  createdAt DateTime @default(now())
  @@unique([operationId,attempt])
}
